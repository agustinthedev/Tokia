{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tokia issue implementation output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "implementation_summary",
    "commits",
    "checks",
    "limitations"
  ],
  "properties": {
    "implementation_summary": {
      "type": "string"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "files",
          "expected_failure",
          "failure_reason"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_failure": {
            "type": "boolean"
          },
          "failure_reason": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "details"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
