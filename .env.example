NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/tokia.sqlite
LOCAL_INTEGRATION_TOKEN=tokia-local-dev-token
MAX_PINS_PER_IMPORT=2000
MAX_REQUEST_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
CONTENT_STORAGE_DIRECTORY=./data/content
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_UPLOAD_BYTES=262144000
APP_SECRETS_ENCRYPTION_KEY=replace-with-a-long-random-secret
MODEL_PROVIDER=local
MODEL_NAME=local-structured-v1

