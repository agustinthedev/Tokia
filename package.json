{
  "name": "tokia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build --workspace @tokia/shared",
    "build:api": "npm run build --workspace @tokia/api",
    "build:web": "npm run build --workspace @tokia/web",
    "build:extension": "npm run build --workspace @tokia/extension",
    "dev": "npm run build:shared && npm run dev --workspace @tokia/api",
    "dev:web": "npm run dev --workspace @tokia/web",
    "start": "npm run start --workspace @tokia/api",
    "migrate": "npm run migrate --workspace @tokia/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vite": "^7.0.6"
  }
}
