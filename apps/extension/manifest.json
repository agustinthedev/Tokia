{
  "manifest_version": 3,
  "name": "Tokia Pinterest Board Importer",
  "version": "0.1.0",
  "description": "Scan Pins from the Pinterest board currently open in your authenticated browser session and send references to Tokia.",
  "icons": {
    "16": "icons/tokia-rocket-16.png",
    "32": "icons/tokia-rocket-32.png",
    "48": "icons/tokia-rocket-48.png",
    "128": "icons/tokia-rocket-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://pin.it/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "action": {
    "default_title": "Import Pinterest board to Tokia",
    "default_icon": {
      "16": "icons/tokia-rocket-16.png",
      "32": "icons/tokia-rocket-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
